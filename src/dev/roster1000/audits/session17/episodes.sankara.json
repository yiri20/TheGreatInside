    { "id": "S2", "text": "National literacy rose from 13% (1983) to 73% (1987); over 350 communities built their own schools with their own labor.", "class": "C", "contexts": ["career_achievement", "leadership_management"], "structure": ["longitudinal_pattern_across_years"], "highStakes": false, "evidenceForm": "documented_action_with_inferred_motive", "explicitMotive": false, "explicitEmotionalReaction": false, "explicitReasoningProcess": false, "observableBehaviorOnly": true, "redundantWith": ["S16"] },
    { "id": "S3", "text": "Over 10 million trees planted; a mandatory tree-planting policy explicitly tied to social-aid eligibility from 1985.", "class": "B", "contexts": ["leadership_management", "institutional_behavior", "career_achievement"], "structure": ["one_time_behavior", "longitudinal_pattern_across_years"], "highStakes": false, "evidenceForm": "documented_action_with_inferred_motive", "explicitMotive": false, "explicitEmotionalReaction": false, "explicitReasoningProcess": false, "observableBehaviorOnly": true, "redundantWith": [] },
    { "id": "S4", "text": "Sold the government's Mercedes-Benz fleet in favor of the cheaper Renault 5 as the official ministerial car.", "class": "A", "contexts": ["leadership_management", "moral_ideological_decision", "institutional_behavior"], "structure": ["one_time_behavior", "repeated_behavior_pattern"], "highStakes": false, "evidenceForm": "documented_action_with_inferred_motive", "explicitMotive": false, "explicitEmotionalReaction": false, "explicitReasoningProcess": false, "observableBehaviorOnly": true, "redundantWith": [] },
    { "id": "S5", "text": "Capped his own presidential salary to the average civil-servant wage (~$450/month).", "class": "A", "contexts": ["moral_ideological_decision", "institutional_behavior"], "structure": ["one_time_behavior", "repeated_behavior_pattern"], "highStakes": false, "evidenceForm": "documented_action_with_inferred_motive", "explicitMotive": false, "explicitEmotionalReaction": false, "explicitReasoningProcess": false, "observableBehaviorOnly": true, "redundantWith": [] },
