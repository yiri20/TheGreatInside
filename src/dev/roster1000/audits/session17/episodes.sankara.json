    { "id": "S8", "text": "1987 OAU address arguing African debt was a direct continuation of colonial control (\"the same ones who used to manage our states and economies... indebted Africa\").", "class": "A", "contexts": ["public_political_engagement", "moral_ideological_decision", "conflict_opposition"], "structure": ["one_time_behavior", "longitudinal_pattern_across_years"], "highStakes": true, "evidenceForm": "self_report", "explicitMotive": false, "explicitEmotionalReaction": false, "explicitReasoningProcess": true, "observableBehaviorOnly": false, "redundantWith": [] },
    { "id": "S9", "text": "Domestic land reforms directly abolished the feudal privileges of traditional tribal chieftaincies.", "class": "A", "contexts": ["leadership_management", "conflict_opposition", "moral_ideological_decision", "institutional_behavior"], "structure": ["one_time_behavior"], "highStakes": true, "evidenceForm": "documented_action_with_inferred_motive", "explicitMotive": false, "explicitEmotionalReaction": false, "explicitReasoningProcess": false, "observableBehaviorOnly": true, "redundantWith": [] },
