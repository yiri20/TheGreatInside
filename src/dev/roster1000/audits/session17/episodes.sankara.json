    { "id": "S13", "text": "Established new institutional infrastructure -- a Ministry of Family Development and the Women's Union of Burkina -- in his first year, specifically to support the women's-rights agenda.", "class": "B", "contexts": ["leadership_management", "institutional_behavior"], "structure": ["one_time_behavior"], "highStakes": false, "evidenceForm": "documented_action_with_inferred_motive", "explicitMotive": false, "explicitEmotionalReaction": false, "explicitReasoningProcess": false, "observableBehaviorOnly": true, "redundantWith": [] },
    { "id": "S14", "text": "A constitutional amendment requiring at least five women ministers in cabinet at all times.", "class": "B", "contexts": ["leadership_management", "institutional_behavior", "moral_ideological_decision"], "structure": ["one_time_behavior"], "highStakes": false, "evidenceForm": "documented_action_with_inferred_motive", "explicitMotive": false, "explicitEmotionalReaction": false, "explicitReasoningProcess": false, "observableBehaviorOnly": true, "redundantWith": [] },
    { "id": "S15", "text": "Refused government chauffeurs and air-conditioned offices, sustained consistently throughout his tenure rather than as a one-off gesture.", "class": "A", "contexts": ["moral_ideological_decision", "institutional_behavior"], "structure": ["repeated_behavior_pattern", "longitudinal_pattern_across_years"], "highStakes": false, "evidenceForm": "documented_action_with_inferred_motive", "explicitMotive": false, "explicitEmotionalReaction": false, "explicitReasoningProcess": false, "observableBehaviorOnly": true, "redundantWith": [] },
