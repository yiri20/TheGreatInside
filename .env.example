# Copy to .env.local for local development and fill in real values there.
# .env.local is gitignored — never commit real values. In Vercel, set these
# as Project → Settings → Environment Variables instead of a file.
# See docs/deployment.md for where each value comes from.

# Supabase — Project Settings -> API Keys (current 2026 key model: the
# publishable/secret pair, not the legacy anon/service_role names).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Production canonical origin. Optional for local dev (falls back to
# http://localhost:3000) - required in production so canonical/hreflang/
# sitemap/OG/share URLs resolve against the real domain, never a Vercel
# preview or *.vercel.app fallback. Do NOT include a trailing slash.
# Production value (2026-08 domain migration): https://thegreatinside.com
NEXT_PUBLIC_SITE_URL=

# Monetization v1 (Deep Inside) — see docs/monetization-v1.md.
# SUPABASE_SECRET_KEY above is also required (the Stripe webhook writes
# purchases/entitlements via that key, bypassing RLS by design).

# Server-only feature flag — deliberately NOT NEXT_PUBLIC_*, since every
# place that needs to know whether monetization is live is a Server
# Component/Action/Route Handler. Must be the literal string "true"; any
# other value (including unset) fails closed — no premium access, no
# Checkout — regardless of whether the Stripe env vars below are also set.
MONETIZATION_ENABLED=

# Stripe — Dashboard -> Developers -> API keys. Use a TEST secret key
# (sk_test_...) until ready to accept real payments.
STRIPE_SECRET_KEY=

# Stripe -> Developers -> Webhooks -> your endpoint -> Signing secret
# (whsec_...). Required to verify that a webhook payload genuinely came
# from Stripe — never processed unverified.
STRIPE_WEBHOOK_SECRET=

# Stripe -> Product catalog -> "Deep Inside" -> the one-time USD $6.99
# Price's id (price_...), not the Product id. The server verifies this
# Price's actual amount/currency against src/core/monetization/product.ts
# before every Checkout Session creation.
STRIPE_DEEP_INSIDE_PRICE_ID=
